source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/6r9u/LIGAND.frcmod
LIG = loadmol2 ./divided-files/6r9u/LIGAND.mol2
PROT = loadpdb ./divided-files/6r9u/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 12
addions COMPLEX Na+ 8
addions COMPLEX Cl- 10
saveamberparm COMPLEX ./divided-files/6r9u/6r9u.top ./divided-files/6r9u/6r9u.crd
savepdb COMPLEX ./divided-files/6r9u/6r9uti.pdb
quit
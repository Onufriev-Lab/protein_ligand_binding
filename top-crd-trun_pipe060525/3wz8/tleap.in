source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/3wz8/LIGAND.frcmod
LIG = loadmol2 ./divided-files/3wz8/LIGAND.mol2
PROT = loadpdb ./divided-files/3wz8/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 12
saveamberparm COMPLEX ./divided-files/3wz8/3wz8.top ./divided-files/3wz8/3wz8.crd
savepdb COMPLEX ./divided-files/3wz8/3wz8t.pdb
quit
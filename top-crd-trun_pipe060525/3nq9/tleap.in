source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/3nq9/LIGAND.frcmod
LIG = loadmol2 ./divided-files/3nq9/LIGAND.mol2
PROT = loadpdb ./divided-files/3nq9/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 12
saveamberparm COMPLEX ./divided-files/3nq9/3nq9.top ./divided-files/3nq9/3nq9.crd
savepdb COMPLEX ./divided-files/3nq9/3nq9t.pdb
quit
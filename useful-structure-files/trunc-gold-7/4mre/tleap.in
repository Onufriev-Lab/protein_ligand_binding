source leaprc.protein.ff19SB
source leaprc.gaff
set default PBradii mbondi3
loadamberparams ./4mre/LIGAND.frcmod
LIG = loadmol2 ./4mre/LIGAND.mol2
PROT = loadpdb ./4mre/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
saveamberparm COMPLEX ./4mre/4mre.top ./4mre/4mre.crd
savepdb COMPLEX ./4mre/4mre.pdb
quit
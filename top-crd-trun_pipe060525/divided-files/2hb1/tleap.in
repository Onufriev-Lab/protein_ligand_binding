source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/2hb1/LIGAND.frcmod
LIG = loadmol2 ./divided-files/2hb1/LIGAND.mol2
PROT = loadpdb ./divided-files/2hb1/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 10
addions COMPLEX Na+ 8
addions COMPLEX Cl- 10
saveamberparm COMPLEX ./divided-files/2hb1/2hb1.top ./divided-files/2hb1/2hb1.crd
savepdb COMPLEX ./divided-files/2hb1/2hb1ti.pdb
quit
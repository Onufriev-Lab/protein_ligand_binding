source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/3gr2/LIGAND.frcmod
LIG = loadmol2 ./divided-files/3gr2/LIGAND.mol2
PROT = loadpdb ./divided-files/3gr2/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 12
addions COMPLEX Na+ 11
addions COMPLEX Cl- 12
saveamberparm COMPLEX ./divided-files/3gr2/3gr2.top ./divided-files/3gr2/3gr2.crd
savepdb COMPLEX ./divided-files/3gr2/3gr2ti.pdb
quit
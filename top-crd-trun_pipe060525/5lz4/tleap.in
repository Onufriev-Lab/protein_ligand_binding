source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/5lz4/LIGAND.frcmod
LIG = loadmol2 ./divided-files/5lz4/LIGAND.mol2
PROT = loadpdb ./divided-files/5lz4/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 12
saveamberparm COMPLEX ./divided-files/5lz4/5lz4.top ./divided-files/5lz4/5lz4.crd
savepdb COMPLEX ./divided-files/5lz4/5lz4t.pdb
quit
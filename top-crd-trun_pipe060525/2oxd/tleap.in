source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/2oxd/LIGAND.frcmod
LIG = loadmol2 ./divided-files/2oxd/LIGAND.mol2
PROT = loadpdb ./divided-files/2oxd/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 10
saveamberparm COMPLEX ./divided-files/2oxd/2oxd.top ./divided-files/2oxd/2oxd.crd
savepdb COMPLEX ./divided-files/2oxd/2oxdt.pdb
quit
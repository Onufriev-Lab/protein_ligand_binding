source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/2f1g/LIGAND.frcmod
LIG = loadmol2 ./divided-files/2f1g/LIGAND.mol2
PROT = loadpdb ./divided-files/2f1g/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 12
saveamberparm COMPLEX ./divided-files/2f1g/2f1g.top ./divided-files/2f1g/2f1g.crd
savepdb COMPLEX ./divided-files/2f1g/2f1gt.pdb
quit
source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/2iwx/LIGAND.frcmod
LIG = loadmol2 ./divided-files/2iwx/LIGAND.mol2
PROT = loadpdb ./divided-files/2iwx/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 12
addions COMPLEX Na+ 11
addions COMPLEX Cl- 14
saveamberparm COMPLEX ./divided-files/2iwx/2iwx.top ./divided-files/2iwx/2iwx.crd
savepdb COMPLEX ./divided-files/2iwx/2iwxti.pdb
quit
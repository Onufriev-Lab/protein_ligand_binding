source leaprc.protein.ff19SB
source leaprc.gaff
set default PBradii mbondi3
loadamberparams ./3uo4/LIGAND.frcmod
LIG = loadmol2 ./3uo4/LIGAND.mol2
PROT = loadpdb ./3uo4/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
saveamberparm COMPLEX ./3uo4/3uo4.top ./3uo4/3uo4.crd
savepdb COMPLEX ./3uo4/3uo4.pdb
quit
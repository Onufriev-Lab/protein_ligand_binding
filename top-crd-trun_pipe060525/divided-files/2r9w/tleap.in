source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/2r9w/LIGAND.frcmod
LIG = loadmol2 ./divided-files/2r9w/LIGAND.mol2
PROT = loadpdb ./divided-files/2r9w/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 12
addions COMPLEX Na+ 11
addions COMPLEX Cl- 11
saveamberparm COMPLEX ./divided-files/2r9w/2r9w.top ./divided-files/2r9w/2r9w.crd
savepdb COMPLEX ./divided-files/2r9w/2r9wti.pdb
quit
source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/6dpz/LIGAND.frcmod
LIG = loadmol2 ./divided-files/6dpz/LIGAND.mol2
PROT = loadpdb ./divided-files/6dpz/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 12
addions COMPLEX Na+ 10
addions COMPLEX Cl- 14
saveamberparm COMPLEX ./divided-files/6dpz/6dpz.top ./divided-files/6dpz/6dpz.crd
savepdb COMPLEX ./divided-files/6dpz/6dpzti.pdb
quit
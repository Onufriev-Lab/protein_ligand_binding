source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/6dy7/LIGAND.frcmod
LIG = loadmol2 ./divided-files/6dy7/LIGAND.mol2
PROT = loadpdb ./divided-files/6dy7/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 10
addions COMPLEX Na+ 9
addions COMPLEX Cl- 7
saveamberparm COMPLEX ./divided-files/6dy7/6dy7.top ./divided-files/6dy7/6dy7.crd
savepdb COMPLEX ./divided-files/6dy7/6dy7ti.pdb
quit
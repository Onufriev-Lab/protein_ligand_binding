source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/3uo4/LIGAND.frcmod
LIG = loadmol2 ./divided-files/3uo4/LIGAND.mol2
PROT = loadpdb ./divided-files/3uo4/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 10
addions COMPLEX Na+ 8
addions COMPLEX Cl- 11
saveamberparm COMPLEX ./divided-files/3uo4/3uo4.top ./divided-files/3uo4/3uo4.crd
savepdb COMPLEX ./divided-files/3uo4/3uo4ti.pdb
quit
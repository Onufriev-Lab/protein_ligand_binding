source leaprc.protein.ff19SB
source leaprc.gaff
loadamberparams ./divided-files/5yay/LIGAND.frcmod
LIG = loadmol2 ./divided-files/5yay/LIGAND.mol2
PROT = loadpdb ./divided-files/5yay/PROTEIN.pdb
COMPLEX = combine {PROT LIG}
source leaprc.water.opc
solvateOct COMPLEX OPCBOX 10
saveamberparm COMPLEX ./divided-files/5yay/5yay.top ./divided-files/5yay/5yay.crd
savepdb COMPLEX ./divided-files/5yay/5yayt.pdb
quit